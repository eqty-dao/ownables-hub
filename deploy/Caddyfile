{$HUB_HOST} {
	# Keep clients on the legacy Sepolia routes working during the SDK rollout.
	# Remove these rewrites once the deployed wallet uses the network routes.
	@legacyOwnables {
		path /ownables /ownables/*
		not path /ownables/*/verification
	}
	rewrite @legacyOwnables /base-sepolia{uri}

	rewrite /public-events /base-sepolia/streams/public-events
	rewrite /hub/wallet/eip155:base /base-sepolia/hub/wallet
	rewrite /api/v1/auth/nonce /auth/nonce
	rewrite /api/v1/auth/verify /auth/verify

	@legacyInbox path_regexp inbox ^/accounts/eip155:84532:(0x[0-9a-fA-F]{40})/available-ownables$
	rewrite @legacyInbox /base-sepolia/inbox/{re.inbox.1}

	@legacyInboxStream path_regexp inboxStream ^/accounts/eip155:84532:(0x[0-9a-fA-F]{40})/available-ownables/events$
	rewrite @legacyInboxStream /base-sepolia/streams/inbox/{re.inboxStream.1}

	@legacyVerification path /ownables/*/verification
	reverse_proxy @legacyVerification hub:8000 {
		rewrite /base-sepolia{uri}
		@missing status 404
		replace_status @missing 400
	}

	reverse_proxy hub:8000
}
