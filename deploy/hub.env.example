LOG_LEVEL=log
CORS_ORIGINS=https://demo.ownables.me
# Comma-separated Base networks with deployed Anchor contracts. Keep Base Mainnet
# disabled until its Anchor address and initialized start block are known.
INDEXER_NETWORKS=base-sepolia
INDEXER_INTERVAL_SECONDS=15

# Base Sepolia remains enabled from its existing cursor tuple.
TESTNET_CHAIN_ID=84532
TESTNET_RPC_URL=
TESTNET_BASE_RPC_URL=
TESTNET_ANCHOR_CONTRACT_ADDR=
# Initialize once with `node deploy/select-start-block.mjs base-sepolia`, then keep the recorded value.
TESTNET_ANCHOR_START_BLOCK=

# Add `base` to INDEXER_NETWORKS only after these Mainnet values are initialized.
MAINNET_CHAIN_ID=8453
MAINNET_RPC_URL=
MAINNET_BASE_RPC_URL=
MAINNET_ANCHOR_CONTRACT_ADDR=
# Initialize with `node deploy/select-start-block.mjs base` before enabling `base`.
MAINNET_ANCHOR_START_BLOCK=

# Use a dedicated signer, not the development fallback wallet.
SIGNER_PRIVATE_KEY=

# Use two private buckets and the endpoint for their jurisdiction.
# For filesystem storage, use file:///var/lib/ownables-hub/archives and
# file:///var/lib/ownables-hub/quarantine on the shared persistent volume.
OWNABLES_STORAGE=s3://eqty-ownables?forcePathStyle=true
QUARANTINE_STORAGE=s3://eqty-quarantine?forcePathStyle=true
AWS_ENDPOINT_URL=
AWS_REGION=auto
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=

UPLOAD_INGRESS_CONCURRENCY=1
UPLOAD_RATE_LIMIT_WINDOW_SECONDS=60
UPLOAD_RATE_LIMIT_MAX_REQUESTS=8
UPLOAD_PROCESSING_CONCURRENCY=1
UPLOAD_MAX_EXPANDED_PROCESSING_BYTES=536870912
QUARANTINE_MAX_PENDING_OBJECTS=4
QUARANTINE_MAX_PENDING_BYTES=536870912
QUARANTINE_RETENTION_SECONDS=86400
QUARANTINE_PROMOTION_BATCH_SIZE=16
QUARANTINE_CLEANUP_BATCH_SIZE=16
QUARANTINE_LEASE_SECONDS=300
QUARANTINE_ORPHAN_GRACE_SECONDS=60
